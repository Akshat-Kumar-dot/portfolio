// Cloudflare Workers: the site is static files only — the build (see the Cloudflare dashboard) copies
// index.html, css/, js/ and assets/ into dist/, and this publishes that folder. No Worker script needed.
{
  "name": "portfolio",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,            // the site's address: portfolio.<account>.workers.dev
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  }
}
